     + fn draw(
     +     f: &mut Frame,
     +     cards: &[Card],
     +     ids: &[&str],
     +     list_state: &mut ListState,
     +     key: KeyFilter,
     +     search: &str,
     +     searching: bool,
     +     detail: bool,
     +     scroll: u16,
     +     color: bool,
     + ) {
