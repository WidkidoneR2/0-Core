{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project 0 Profile Registry",
  "type": "object",
  "properties": {
    "profile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "emoji": { "type": "string" }
        }
      }
    }
  }
}
