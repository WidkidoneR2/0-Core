# ═══════════════════════════════════════════════════════════
# 🛡️ Faelight Forest - Security-First .gitignore
# ═══════════════════════════════════════════════════════════

# CRITICAL: SSH Keys & Certificates
**/.ssh/
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/*.pem
**/*.key
**/*.crt
**/*.p12

# CRITICAL: GPG Keys
**/.gnupg/
**/secring.gpg
**/pubring.gpg

# CRITICAL: Credentials & Secrets
**/secrets.conf
**/secrets.toml
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/tokens
**/.env
**/.env.*
**/credentials
**/credentials.*
**/*_secret*
**/*_token*
**/*_key*
**/password*
**/passwd*

# VPN Credentials
**/mullvad-account.txt
**/.config/mullvad-vpn/account-history.json
**/.config/mullvad-vpn/settings.json

# Browser Data (may contain saved passwords)
**/.mozilla/firefox/*/logins.json
**/.config/google-chrome/
**/.config/chromium/*/Login Data
**/.config/BraveSoftware/Brave-Browser/*/Login Data

# NetworkManager (WiFi passwords!)
**/system-connections/
**/NetworkManager/system-connections/

# Shell history (may contain typed passwords)
**/fish_history
fish/.config/fish/fish_history
**/nushell/history.sqlite3*
**/nushell/history.txt

# Git credentials
**/.git-credentials
**/.gitconfig.local
**/.gitconfig

# Cloud storage tokens
**/.config/rclone/rclone.conf

# GitHub CLI
**/.config/gh/hosts.yml

# ═══════════════════════════════════════════════════════════
# 🦀 Build Artifacts (Source-First Strategy)
# ═══════════════════════════════════════════════════════════

# Compiled binaries (build fresh from rust-tools/)
scripts/

# Rust build artifacts
target/
rust-tools/*/target/

# ═══════════════════════════════════════════════════════════
# 🗂️ Local-Only Files
# ═══════════════════════════════════════════════════════════

# Backup and working dirs
backups/
BACKUPS/

# Stow artifacts
03-interfaces/.zshrc
03-interfaces/.config/

# Session state and drafts
**/SESSION_STATE.md
CHANGELOG-v8.0.0-DRAFT.md

# Research source (local only)
docs/planning/faelight-term/alacritty/
docs/planning/faelight-term/foot-source/

# Editor temp files
*.swp
*.swo
*.tmp
*.temp
*~
*.backup
shell-zsh/.config/zsh/.zcompdump*

# Logs
**/*.log
**/logs/
logs/

# Temp dirs
**/temp/
**/tmp/

# Stow metadata
.dotmeta
.install-files/

# Explicitly marked sensitive files
**/*SECRET*
**/*PRIVATE*
**/*CONFIDENTIAL*
**/*-secret*
**/*-SECRET*
runtime/
engine/target/
# INT-166 — state.db backups
runtime/backups/
runtime/state.db.bak
runtime/state.db-wal
runtime/state.db-shm
