#!/usr/bin/env bash
# faelight vm -- smooth VM workflow (INT-077)
# Subcommands: build | up | ssh | down | status
# Console path = SSH (host 2222 -> guest 22), per INT-077 gate 2.
set -euo pipefail

REPO="${FAELIGHT_REPO:-$HOME/0-core}"
FLAKE="$REPO#faelight-vm"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/faelight-vm"
PORT=2222
GUEST_USER=christian
LOG="$STATE/vm.log"
PIDFILE="$STATE/vm.pid"
SPICE_SOCK="$STATE/spice.sock"
SSH_OPTS=(-t -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p "$PORT")

mkdir -p "$STATE"

c_g=$'\e[38;2;57;255;20m'; c_c=$'\e[38;2;50;220;255m'
c_a=$'\e[38;2;255;200;50m'; c_r=$'\e[38;2;255;80;80m'; c_o=$'\e[0m'
info(){ printf '%s%s%s\n' "$c_c" "$*" "$c_o"; }
ok(){   printf '%s%s%s\n' "$c_g" "$*" "$c_o"; }
warn(){ printf '%s%s%s\n' "$c_a" "$*" "$c_o"; }
err(){  printf '%s%s%s\n' "$c_r" "$*" "$c_o" >&2; }

launcher(){ ls "$STATE"/result/bin/run-*-vm 2>/dev/null | head -1 || true; }
port_open(){ timeout 1 bash -c ">/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; }

# INT-077: fsh shadows pkill/kill/pgrep, so we identify+kill qemu via a Python /proc
# walker (proven reliable). vm_pids prints matching PIDs; vm_kill SIGKILLs them.
VMMATCH='qemu-system-x86_64'
vm_pids(){
  python3 - "$VMMATCH" <<'PYV'
import glob, sys
needle = sys.argv[1]
for d in glob.glob("/proc/[0-9]*"):
    try:
        cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
    except Exception:
        continue
    if needle in cmd and "faelight-vm" in cmd:
        print(d.split("/")[-1])
PYV
}
vm_kill(){
  python3 - "$VMMATCH" <<'PYV'
import glob, os, signal, sys, time
needle = sys.argv[1]
def find():
    out=[]
    for d in glob.glob("/proc/[0-9]*"):
        try:
            cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
        except Exception:
            continue
        if needle in cmd and "faelight-vm" in cmd:
            out.append(int(d.split("/")[-1]))
    return out
killed=[]
for pid in find():
    try: os.kill(pid, signal.SIGKILL); killed.append(pid)
    except ProcessLookupError: pass
time.sleep(1)
print("KILLED" if killed else "NONE", *killed)
print("REMAIN", *find())
PYV
}
kill_viewer(){
  python3 - <<'PYV'
import glob, os, signal
for d in glob.glob("/proc/[0-9]*"):
    try:
        cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
    except Exception:
        continue
    if "remote-viewer" in cmd and "spice" in cmd:
        try: os.kill(int(d.split("/")[-1]), signal.SIGKILL)
        except ProcessLookupError: pass
PYV
}

cmd_build(){
  info "Building VM image (nixos-rebuild build-vm; dirty tree uses tracked files)..."
  ( cd "$STATE" && nixos-rebuild build-vm --flake "$FLAKE" )
  local L; L="$(launcher)"
  [ -n "$L" ] && ok "VM image built (GC-rooted): $L" || { err "build done but no run-*-vm launcher in $STATE/result/bin"; exit 1; }
}

cmd_up(){
  local L; L="$(launcher)"
  [ -n "$L" ] || { err "No VM image. Run: vm build"; exit 1; }
  if [ -n "$(vm_pids)" ]; then err "A faelight-vm is ALREADY running (PIDs: $(vm_pids | tr '\n' ' ')). Run: vm down  first."; exit 1; fi
  if port_open; then ok "VM already up (port $PORT listening)"; return 0; fi
  info "Launching VM (headless, detached; log -> $LOG)..."
  ( cd "$STATE" && exec setsid "$L" >"$LOG" 2>&1 </dev/null ) &
  echo $! >"$PIDFILE"
  local i
  for i in $(seq 1 60); do
    if port_open; then ok "VM up -- ssh ready on port $PORT (after ${i}s)"; return 0; fi
    sleep 1
  done
  err "VM did not open port $PORT within 60s -- check $LOG"; exit 1
}

cmd_ssh(){
  if ! port_open; then warn "VM not up; starting it..."; cmd_up; fi
  info "ssh -> $GUEST_USER@localhost:$PORT (password: faelight)"
  ssh "${SSH_OPTS[@]}" "$GUEST_USER@localhost" "$@"
}

cmd_down(){
  # INT-077: kill qemu by real PID via Python (/proc), NOT fsh's broken pkill.
  local res; res="$(vm_kill)"
  # REMAIN line lists leftover PIDs after the label; strip label, keep only real PIDs.
  local remain; remain="$(echo "$res" | sed -n 's/^REMAIN //p' | tr -s ' ')"
  remain="$(echo "$remain" | grep -o '[0-9][0-9]*' | tr '\n' ' ' || true)"
  local killpids; killpids="$(echo "$res" | sed -n 's/^KILLED //p')"
  if [ -n "$killpids" ]; then ok "VM stopped ($killpids)."; else warn "No running VM found."; fi
  if [ -n "$remain" ]; then err "WARNING: qemu still running: $remain (manual: /run/current-system/sw/bin/kill -9 $remain)"; fi
  kill_viewer
  rm -f "$PIDFILE" "$SPICE_SOCK"
  info "Disk state persists at $STATE/*.qcow2 (delete for a clean boot; deeper reset -> INT-027)."
}

cmd_gui(){
  local L; L="$(launcher)"
  [ -n "$L" ] || { err "No VM image. Run: vm build"; exit 1; }
  if [ -n "$(vm_pids)" ] || port_open; then
    warn "A VM is already running. Run: vm down  then  vm gui"
    exit 1
  fi
  command -v remote-viewer >/dev/null || { err "remote-viewer not found (pkgs.virt-viewer on host)"; exit 1; }
  kill_viewer
  rm -f "$SPICE_SOCK"
  info "Launching VM with SPICE display (socket: $SPICE_SOCK)..."
  # SPICE on a unix socket + virtio-gpu + agent channel for shared clipboard.
  local QOPTS="-device virtio-gpu-gl -display egl-headless,rendernode=/dev/dri/renderD128 -spice unix=on,addr=$SPICE_SOCK,disable-ticketing=on -device virtio-serial-pci -chardev spicevmc,id=vdagent,name=vdagent -device virtserialport,chardev=vdagent,name=com.redhat.spice.0"
  ( cd "$STATE" && exec setsid env QEMU_OPTS="$QOPTS" "$L" >"$LOG" 2>&1 </dev/null ) &
  echo $! >"$PIDFILE"
  local i
  for i in $(seq 1 30); do [ -S "$SPICE_SOCK" ] && break; sleep 1; done
  [ -S "$SPICE_SOCK" ] || { err "SPICE socket never appeared -- check $LOG"; exit 1; }
  ok "SPICE up. Opening remote-viewer (windowed)..."
  setsid remote-viewer "spice+unix://$SPICE_SOCK" >>"$LOG" 2>&1 </dev/null &  # INT-077: windowed (NOT fullscreen) -- closeable, no screen-trap
  ok "Viewer launched. SSH still available: vm ssh"
}

cmd_status(){
  local L; L="$(launcher)"
  printf '%sfaelight-vm%s\n' "$c_c" "$c_o"
  [ -n "$L" ] && ok "  image:  $L" || warn "  image:  none (run: vm build)"
  if port_open; then ok "  state:  UP (port $PORT listening)"; else warn "  state:  down"; fi
  [ -f "$LOG" ] && info "  log:    $LOG" || true
  for q in "$STATE"/*.qcow2; do [ -e "$q" ] && info "  disk:   $q ($(du -h "$q" | cut -f1))"; done
}

usage(){
  cat <<EOF
faelight vm -- smooth VM workflow (INT-077)
  vm build    build/refresh the VM image (slow; run when hosts/vm/ changes)
  vm up       launch headless + wait for ssh (port $PORT)
  vm ssh [c]  ssh into the guest (optional remote command)
  vm down     stop the VM (disk state persists)
  vm status   image / running / disk
  vm gui      launch with a SPICE window (remote-viewer) + shared clipboard
Console = SSH (host $PORT -> guest 22). Guest: $GUEST_USER / pw faelight.
EOF
}

case "${1:-}" in
  build)  shift; cmd_build  "$@";;
  up)     shift; cmd_up     "$@";;
  ssh)    shift; cmd_ssh    "$@";;
  down)   shift; cmd_down   "$@";;
  gui)    shift; cmd_gui    "$@";;
  status) shift; cmd_status "$@";;
  ""|-h|--help|help) usage;;
  *) err "unknown subcommand: $1"; usage; exit 2;;
esac
