#!/usr/bin/env bash
# Tracked hook -- see .githooks/README.md
#
# zero-gate runs first (nsh-test, then cargo test -p core). Then each pushed
# ref is checked with core intent seals check (INT-306). An absent binary is
# not a pass.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

find_bin() {
    local name=$1
    local candidate
    for candidate in "$root/target/debug/$name" "$root/target/release/$name"; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
        return 0
    fi
    return 1
}

# stdin is the push's ref lines:
#   <local ref> <local sha> <remote ref> <remote sha>
# A delete (local sha all zeros) is skipped. A new ref (remote sha all zeros)
# is the commits on the local sha that are not on any remote. An update is
# remote..local.
check_pushed_refs() {
    local core=$1
    local local_ref local_sha remote_ref remote_sha
    local zeros=0000000000000000000000000000000000000000
    while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
        [[ -n "${local_sha:-}" ]] || continue
        if [[ "$local_sha" == "$zeros" ]]; then
            continue
        fi
        if [[ "$remote_sha" == "$zeros" ]]; then
            "$core" intent seals check "$local_sha" --not --remotes
        else
            "$core" intent seals check "${remote_sha}..${local_sha}"
        fi
    done
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# The ref lines are on stdin. Read them before zero-gate: its pre-push runs
# nsh-test and cargo test, and a child that reads stdin would swallow the
# lines. The seal check would then see an empty push and pass.
push_lines=$(cat)

gate=$(find_bin zero-gate) || {
    echo "zero-gate not found -- build it (cargo build -p zero-gate) or install it." >&2
    echo "Refusing to pass: an absent gate is not a satisfied gate." >&2
    exit 1
}
"$gate" pre-push </dev/null

corebin=$(find_bin core) || {
    echo "core not found -- build it (cargo build -p core) or install it." >&2
    echo "Refusing to pass: an absent seal check is not a satisfied check." >&2
    exit 1
}
printf '%s\n' "$push_lines" | check_pushed_refs "$corebin"
