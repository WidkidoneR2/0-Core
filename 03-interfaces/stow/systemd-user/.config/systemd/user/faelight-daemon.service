[Unit]
Description=Faelight Forest Daemon
Documentation=https://github.com/WidkidoneR2/0-Core
After=default.target

[Service]
Type=simple
ExecStart=%h/0-core/scripts/faelight-daemon
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=faelight-daemon
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
