[Unit]
Description=Faelight Daemon - Universal File Management RPC Server
Documentation=https://github.com/WidkidoneR2/0-Core
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/0-core/04-runtime/target/release/faelight-daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening (removed PrivateTmp - conflicts with /tmp socket)
NoNewPrivileges=true

[Install]
WantedBy=default.target
