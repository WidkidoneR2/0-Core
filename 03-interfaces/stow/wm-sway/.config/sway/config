# Specialized Tools
bindsym $mod+Ctrl+d exec $term -e ~/0-core/scripts/core-diff
bindsym $mod+Ctrl+a exec $term -e ~/0-core/scripts/archaeology-0-core
bindsym $mod+Ctrl+c exec $term -e ~/0-core/scripts/compile-changelog.sh
bindsym $mod+Ctrl+g exec $term -e ~/0-core/scripts/faelight-stow


# Faelight Palette - Centered floating window
for_window [app_id="faelight-palette-float"] {
    floating enable
    resize set 800 600
    move position center
    border pixel 2
    border_color #00FFFF
}

# Global Faelight Palette - Ctrl+Space
bindsym Control+Space exec foot --app-id=faelight-palette-float -e /home/christian/0-core/scripts/faelight-palette

# Faelight Bar - Auto-start detached
exec ~/0-core/scripts/launch-bar
xwayland enable

# Faelight Menu - Floating window
for_window [app_id="faelight-menu-float"] floating enable, resize set 450 350, move position center

# Keybind: SUPER+ESC for menu
bindsym $mod+Escape exec foot --app-id=faelight-menu-float -e /home/christian/0-core/scripts/faelight-menu
