// ─────────────────────────────────────────────────────────
// Faelight Forest — Niri Configuration
// Migrated from Sway, following INT-099
// "The forest grows its own roots"
// ─────────────────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.3
    }

    mouse {
        accel-speed 0.0
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-2" {
    scale 1.5
    background-color "#0f1411"
}

layout {
    gaps 12
    struts {
        left 4
        right 4
        top 4
        bottom 4
    }
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#a3e36b"
        inactive-color "#1a2410"
    }

    border {
        width 2
        active-color "#a3e36b88"
        inactive-color "#1a241066"
    }
}

// ─── Autostart ────────────────────────────────────────────
spawn-at-startup "sh" "-c" "/home/christian/0-core/scripts/faelight-wallpaper"
// faelight-clipboard watch disabled: Wayland zwlr panic on startup (2026-03-31)
spawn-at-startup "sh" "-c" "/home/christian/0-core/scripts/launch-bar"
spawn-at-startup "sh" "-c" "/home/christian/0-core/scripts/faelight-niri-bridge"
spawn-at-startup "sh" "-c" "/home/christian/0-core/scripts/faelight-idle"

// ── Forest Animations ────────────────────────────────────
animations {
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }
    workspace-switch {
        duration-ms 220
        curve "ease-out-cubic"
    }
    window-movement {
        duration-ms 180
        curve "ease-out-cubic"
    }
    window-resize {
        duration-ms 180
        curve "ease-out-cubic"
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// ─── Window Rules ─────────────────────────────────────────
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="blueman-manager"
    open-floating true
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}

window-rule {
    match app-id="faelight-palette-float"
    open-floating true
    default-floating-position x=600 y=300 relative-to="top-left"
}

window-rule {
    match app-id="faelight-menu-float"
    open-floating true
    default-floating-position x=600 y=300 relative-to="top-left"
}

window-rule {
    match title="Picture-in-Picture"
    open-floating true
}

// ─── Key Bindings ─────────────────────────────────────────
binds {
    // ── Apps ──────────────────────────────────────────────
    Mod+Alt+Return  { spawn "/home/christian/0-core/scripts/faelight-term"; }
    Mod+Return      { spawn "foot"; }
    Mod+b           { spawn "brave"; }
    Mod+Alt+b       { spawn "/home/christian/0-core/scripts/faelight-browser"; }
    Mod+e           { spawn "/home/christian/0-core/scripts/faelight-fm"; }
    Mod+n           { spawn "foot" "-e" "nvim"; }
    Mod+Shift+y     { spawn "foot" "-e" "yazi"; }
    Mod+Shift+t     { spawn "foot" "-e" "btop"; }
    Mod+Shift+n     { spawn "foot" "-e" "nvim"; }
    Mod+Shift+f     { spawn "/home/christian/0-core/scripts/faelight-fm"; }

    // ── Faelight Tools ────────────────────────────────────
    Mod+Space       { spawn "foot" "--app-id=faelight-palette-float" "-W" "80x24" "-e" "/home/christian/0-core/scripts/faelight-palette"; }
    Mod+Escape      { spawn "foot" "--app-id=faelight-menu-float" "-W" "60x20" "-e" "/home/christian/0-core/scripts/faelight-menu"; }
    Mod+Alt+k       { spawn "keepassxc"; }
    Mod+Alt+e       { spawn "tutanota-desktop"; }
    Mod+Alt+n       { spawn "notesnook"; }
    Mod+Alt+d       { spawn "discord"; }
    Mod+Alt+c       { spawn "filen-desktop"; }
    Mod+Alt+h       { spawn "foot" "-e" "/home/christian/0-core/scripts/dot-doctor"; }
    Mod+Alt+m       { spawn "/home/christian/0-core/scripts/faelight-dashboard"; }
    Mod+Alt+g       { spawn "foot" "-e" "/home/christian/0-core/scripts/faelight-git"; }
    Mod+Alt+i       { spawn "foot" "-e" "/home/christian/0-core/scripts/intent"; }
    Mod+Alt+z       { spawn "/home/christian/0-core/scripts/faelight-snapshot"; }
    Mod+Alt+u       { spawn "foot" "-e" "/home/christian/0-core/scripts/safe-update"; }
    Mod+Alt+p       { spawn "foot" "-e" "/home/christian/0-core/scripts/core-protect"; }
    Mod+Alt+f       { spawn "foot" "-e" "/home/christian/0-core/scripts/profile"; }
    Mod+Alt+a       { spawn "foot" "-e" "/home/christian/0-core/scripts/keyscan"; }
    Mod+Alt+v       { spawn "sh" "-c" "notify-send '🌲 Faelight Forest' '10.3.0'"; }
    Mod+Alt+l       { spawn "foot" "-e" "/home/christian/0-core/scripts/latest-update"; }
    Mod+Alt+w       { spawn "foot" "-e" "/home/christian/0-core/scripts/dotctl"; }
    Mod+Ctrl+d      { spawn "foot" "-e" "/home/christian/0-core/scripts/core-diff"; }
    Mod+Ctrl+c      { spawn "foot" "-e" "/home/christian/0-core/scripts/compile-changelog.sh"; }
    Mod+Ctrl+g      { spawn "foot" "-e" "/home/christian/0-core/scripts/faelight-stow"; }

    // ── Clipboard ─────────────────────────────────────────
    Mod+p           { spawn "sh" "-c" "cliphist list | foot --app-id=faelight-palette-float -W 80x24 -e fzf | cliphist decode | wl-copy"; }
    Mod+Shift+p     { spawn "sh" "-c" "cliphist wipe && notify-send '📋 Clipboard' 'History cleared'"; }

    // ── Notifications ─────────────────────────────────────
    Mod+i           { spawn "sh" "-c" "/home/christian/0-core/scripts/faelight-notifyctl set-mode do-not-disturb"; }
    Mod+Shift+i     { spawn "sh" "-c" "/home/christian/0-core/scripts/faelight-notifyctl set-mode default"; }
    Mod+Ctrl+i      { spawn "sh" "-c" "/home/christian/0-core/scripts/faelight-notifyctl dismiss -a"; }

    // ── Screenshots ───────────────────────────────────────
    Mod+s           { spawn "sh" "-c" "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send '📸 Screenshot' 'Full screen saved'"; }
    Mod+Shift+s     { spawn "sh" "-c" "grim -g \"$(slurp)\" ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send '📸 Screenshot' 'Area saved'"; }
    Mod+Alt+s       { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy && notify-send '📸 Screenshot' 'Copied to clipboard'"; }

    // ── Lock / Session ────────────────────────────────────
    Mod+Ctrl+Escape { spawn "/home/christian/0-core/scripts/faelight-lock"; }
    Mod+Shift+e     { quit; }

    // ── Window Management ─────────────────────────────────
    Mod+q           { close-window; }
    Mod+f           { fullscreen-window; }
    Mod+v           { toggle-window-floating; }
    Mod+Shift+Space { toggle-window-floating; }

    // ── Focus ─────────────────────────────────────────────
    Mod+h           { focus-column-left; }
    Mod+l           { focus-column-right; }
    Mod+j           { focus-window-down; }
    Mod+k           { focus-window-up; }
    Mod+Left        { focus-column-left; }
    Mod+Right       { focus-column-right; }
    Mod+Down        { focus-window-down; }
    Mod+Up          { focus-window-up; }

    // ── Move ──────────────────────────────────────────────
    Mod+Shift+h     { move-column-left; }
    Mod+Shift+l     { move-column-right; }
    Mod+Shift+j     { move-window-down; }
    Mod+Shift+k     { move-window-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    // ── Resize ────────────────────────────────────────────
    Mod+Ctrl+h      { set-column-width "-10%"; }
    Mod+Ctrl+l      { set-column-width "+10%"; }
    Mod+Ctrl+j      { set-window-height "+10%"; }
    Mod+Ctrl+k      { set-window-height "-10%"; }
    Mod+r           { switch-preset-column-width; }

    // ── Niri Column Management (no Sway equivalent) ───────
    Mod+Comma       { consume-window-into-column; }
    Mod+Period      { expel-window-from-column; }
    Mod+Ctrl+f      { expand-column-to-available-width; }
    Mod+Home        { focus-column-first; }
    Mod+End         { focus-column-last; }
    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // ── Mouse wheel ───────────────────────────────────────
    Mod+WheelScrollRight      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft       cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // ── Workspaces ────────────────────────────────────────
    Mod+1           { focus-workspace 1; }
    Mod+2           { focus-workspace 2; }
    Mod+3           { focus-workspace 3; }
    Mod+4           { focus-workspace 4; }
    Mod+5           { focus-workspace 5; }

    Mod+Shift+1     { move-column-to-workspace 1; }
    Mod+Shift+2     { move-column-to-workspace 2; }
    Mod+Shift+3     { move-column-to-workspace 3; }
    Mod+Shift+4     { move-column-to-workspace 4; }
    Mod+Shift+5     { move-column-to-workspace 5; }

    Mod+Alt+1       { move-column-to-workspace 1; }
    Mod+Alt+2       { move-column-to-workspace 2; }
    Mod+Alt+3       { move-column-to-workspace 3; }
    Mod+Alt+4       { move-column-to-workspace 4; }
    Mod+Alt+5       { move-column-to-workspace 5; }

    Mod+bracketright        { focus-workspace-down; }
    Mod+bracketleft         { focus-workspace-up; }
    Mod+Tab                 { focus-workspace-previous; }
    Mod+grave               { focus-workspace-previous; }
    Mod+Shift+bracketright  { move-column-to-workspace-down; }
    Mod+Shift+bracketleft   { move-column-to-workspace-up; }

    // ── Media Keys ────────────────────────────────────────
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}

// ── Forest Visual Identity — INT-136 ─────────────────────
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match is-focused=false
    opacity 0.92
}

// ── Per-app window rules — INT-136 Phase 2 ───────────────
// Foot terminal — slightly more transparent, structured corners
window-rule {
    match app-id="foot"
    opacity 0.95
    geometry-corner-radius 6
}

// Floating windows — softer corners
window-rule {
    match is-floating=true
    geometry-corner-radius 12
}
