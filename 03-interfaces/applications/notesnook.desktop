[Desktop Entry]
Name=Notesnook
Exec=notesnook --enable-features=UseOzonePlatform --ozone-platform=wayland %U
Terminal=false
Type=Application
Icon=notesnook
StartupWMClass=Notesnook
Comment=Your private note taking space (Wayland native)
Categories=Office;

[Desktop Action new-note]
Name=New note
Exec=notesnook --enable-features=UseOzonePlatform --ozone-platform=wayland new note

[Desktop Action new-notebook]
Name=New notebook
Exec=notesnook --enable-features=UseOzonePlatform --ozone-platform=wayland new notebook

[Desktop Action new-reminder]
Name=New reminder
Exec=notesnook --enable-features=UseOzonePlatform --ozone-platform=wayland new reminder
