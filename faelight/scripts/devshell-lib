# devshell-lib -- the facts every devshell script shares. INT-257. Sourced, never run.
#
# ONE definition of where sessions live and which layers a session has. Four scripts used to
# carry their own copies, and it cost twice: `ls | tail -1` picked the wrong session once, and
# checkpoint SILENTLY SKIPPED /usr and the pacman database because it knew two layers by name --
# a restore would have rolled a session back while leaving an installed package in place.

DEVSHELL_DATA="$HOME/.local/share/devshell"
DEVSHELL_LOWER="$DEVSHELL_DATA/lower"
# Sessions live ON DISK, beside the /usr copy, on the same btrfs as HOME: they survive a reboot,
# and a session's copy-up is a clone (measured: 300 MB in 31 ms, 0 bytes exclusive). Safe only
# since the declared HOME (C-a): HOME's lower is an empty directory and ~/.local/share is in no
# declared row, so no session sits inside any overlay's lower layer.
DEVSHELL_SESSIONS="$DEVSHELL_DATA/sessions"
DEVSHELL_PREFIX="devshell-"

# THE DECLARED HOME -- Christian's ruling, 2026-09-21. One row per path: name, path under HOME,
# mode. HOME inside starts EMPTY and only these cross; everything else -- .ssh, .git-credentials,
# secureboot keys, tokens nobody has listed yet -- is absent BY CONSTRUCTION, not hidden.
#   live      the host's directory, overlaid: edits on the host are seen inside
#   snapshot  a consistent copy taken when the session is born -- for what the host writes on
#             every command, where a live lower layer would be overlayfs's undefined case
DEVSHELL_DECLARED=$'core\t0-core\tlive
bin\t.local/bin\tlive
nshconf\t.config/faelight-shell\tlive
cargo\t.cargo\tlive
state\t.local/state/faelight\tsnapshot'

# A consistent copy of a directory the host keeps writing. Reflink for the bulk (auto: a clone on
# btrfs, a real copy elsewhere). Sockets DROPPED: a copied socket is a door to nothing, and nothing
# inside should look like a door.
#
# Every SQLite database is taken as a VERIFIED CLONE. A db and its WAL copied while nothing wrote
# to them are a crash image, and SQLite recovers a crash image exactly. So: record size and
# nanosecond mtime of both, clone both, record again -- any change means a write landed mid-copy,
# discard and retry -- then OPEN the clone: its header, schema and the WAL's checksummed frames are
# read, which is what recovering a crash image requires. Five failures fall back to sqlite's own
# online backup. NOT quick_check: measured 2026-09-21, it read all 76,857 pages for 4.63 s of a
# 4.89 s launch, re-proving what the size-and-mtime check already proved -- that nothing wrote. The clone shares every extent with the host: ZERO bytes per session, where the backup
# alone cost a full 300 MB copy EVERY session (1.5G of RAM across five sessions, measured).
# Prints the method used, so the session records how its snapshot was made.
snapshot_dir() {
    local src="$1" dst="$2" f
    local -a dbs
    mkdir -p "$dst" || return 1
    cp -a --reflink=auto "$src/." "$dst/" || return 1
    find "$dst" -type s -delete || return 1
    mapfile -t dbs < <(find "$dst" -maxdepth 1 -type f -name '*.db')
    for f in "${dbs[@]}"; do
        python3 -c 'import os, sqlite3, subprocess, sys
src, dst = sys.argv[1], sys.argv[2]
def sig():
    out = []
    for p in (src, src + "-wal"):
        try:
            st = os.stat(p)
            out.append((st.st_size, st.st_mtime_ns))
        except FileNotFoundError:
            out.append(None)
    return out
def clear():
    for p in (dst, dst + "-wal", dst + "-shm"):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
for attempt in range(5):
    clear()
    before = sig()
    subprocess.run(["cp", "--reflink=auto", src, dst], check=True)
    if os.path.exists(src + "-wal"):
        subprocess.run(["cp", "--reflink=auto", src + "-wal", dst + "-wal"], check=True)
    if sig() != before:
        continue
    c = sqlite3.connect(dst)
    ok = c.execute("pragma page_count").fetchone()[0] > 0 and c.execute("select count(*) from sqlite_master").fetchone()[0] > 0
    c.close()
    if ok:
        print("image-verified attempt=%d" % (attempt + 1))
        sys.exit(0)
clear()
s = sqlite3.connect("file:" + src + "?mode=ro", uri=True)
d = sqlite3.connect(dst)
s.backup(d)
d.close()
print("sqlite-backup")' "$src/${f##*/}" "$f" || return 1
    done
}

# The newest session by mtime -- never by name.
last_session() {
    local s
    s="$(ls -dt "$DEVSHELL_SESSIONS/$DEVSHELL_PREFIX"*/ 2>/dev/null | head -1)" || true
    printf '%s\n' "${s%/}"
}

# OLD SESSIONS GO AWAY ON THEIR OWN -- Christian's ruling, 2026-09-21. When a new session is born,
# every session UNUSED for more than DEVSHELL_KEEP_DAYS is removed -- unless it holds a checkpoint
# (someone chose to keep a point in it) or it is running. Every launch touches its session, so
# "unused" means not entered, not merely old.
DEVSHELL_KEEP_DAYS=7
sessions_gc() {
    local d removed=0
    [ -d "$DEVSHELL_SESSIONS" ] || return 0
    for d in "$DEVSHELL_SESSIONS/$DEVSHELL_PREFIX"*/; do
        d="${d%/}"
        [ -d "$d" ] || continue
        [ -n "$(find "$d" -maxdepth 0 -mtime +"$DEVSHELL_KEEP_DAYS")" ] || continue
        [ -n "$(ls -A "$d/checkpoints" 2>/dev/null)" ] && continue
        pgrep -f "$d/upper" > /dev/null 2>&1 && continue
        chmod -R u+rwX "$d" 2> /dev/null
        rm -rf "$d" && removed=$((removed + 1))
    done
    if [ "$removed" -gt 0 ]; then
        echo "  gc: removed $removed session(s) unused for over $DEVSHELL_KEEP_DAYS days"
    fi
    return 0
}

# THE LAYER TABLE: one line per layer -- name, mount point, lower -- tab separated. Upper and
# work are always $ROOT/upper-<name> and $ROOT/work-<name>. Written ONCE, when a session is
# born, so a resumed session keeps the layers it was born with even after the defaults change.
layers_new() {
    local root="$1" name rel mode m
    mkdir -p "$root/empty-home" || return 1
    {
        printf 'etc\t/etc\t/etc\n'
        if [ -d "$DEVSHELL_LOWER/usr" ] && [ -d "$DEVSHELL_LOWER/var/lib/pacman/local" ]; then
            printf 'usr\t/usr\t%s\n' "$DEVSHELL_LOWER/usr"
            printf 'pacman\t/var/lib/pacman\t%s\n' "$DEVSHELL_LOWER/var/lib/pacman"
        fi
        # HOME's lower is an EMPTY directory. Declared rows follow it, so they mount on top.
        printf 'home\t%s\t%s\n' "$HOME" "$root/empty-home"
    } > "$root/layers" || return 1
    while IFS=$'\t' read -r name rel mode; do
        [ -n "$name" ] || continue
        [ -d "$HOME/$rel" ] || continue
        if [ "$mode" = "snapshot" ]; then
            m="$(snapshot_dir "$HOME/$rel" "$root/snap-$name")" || return 1
            printf '%s\n' "$m" > "$root/snap-$name.method"
            printf '%s\t%s\t%s\n' "$name" "$HOME/$rel" "$root/snap-$name" >> "$root/layers"
        else
            printf '%s\t%s\t%s\n' "$name" "$HOME/$rel" "$HOME/$rel" >> "$root/layers"
        fi
    done <<< "$DEVSHELL_DECLARED"
}

# A session born before the table existed gets the table it ACTUALLY had, read off its upper
# directories -- never today's defaults, which could name a layer it never mounted.
layers_read() {
    local root="$1"
    if [ -f "$root/layers" ]; then
        cat "$root/layers"
        return 0
    fi
    printf 'etc\t/etc\t/etc\n'
    if [ -d "$root/upper-usr" ]; then printf 'usr\t/usr\t%s\n' "$DEVSHELL_LOWER/usr"; fi
    if [ -d "$root/upper-pacman" ]; then printf 'pacman\t/var/lib/pacman\t%s\n' "$DEVSHELL_LOWER/var/lib/pacman"; fi
    printf 'home\t%s\t%s\n' "$HOME" "$HOME"
}
