#!/usr/bin/env bash
# devshell -- a world you live in. INT-257.
#
# Ten laws, enforced by bubblewrap:
#   1 filesystem  / looks real, every mutation disposable unless promoted
#   2 process     cannot see or signal anything outside
#   3 network     nothing, unless asked for
#   4 identity    root inside, no authority outside
#   5 environment nothing crosses unless declared
#   6 machine     it says what it is
#   7 reversible  leaving restores the prior state
#   8 observable  the upper layer IS the diff
#   9 sudo        not a door
#   0 a sandbox that cannot deliver a law REFUSES
set -euo pipefail

# The facts every devshell script shares -- ONE definition, INT-257.
source "$(dirname "$(readlink -f "$0")")/devshell-lib"

# --resume <session|last> walks back into a world you left. Without it every launch was a
# new session, and checkpoints could be saved but never used -- the sandbox was one-shot,
# not a transaction.
CREATED=1
if [ "${1:-}" = "--resume" ]; then
    target="${2:-}"
    [ "$target" = "last" ] && target="$(last_session)"
    [ -d "$target/upper-home" ] || { echo "devshell: no session to resume: ${2:-}" >&2; exit 1; }
    ROOT="$target"
    SESSION="${ROOT#/tmp/devshell-}"
    CREATED=0
    shift 2
else
    SESSION="$(date +%Y%m%d-%H%M%S)"
    ROOT="/tmp/devshell-$SESSION"
    mkdir -p "$ROOT/upper-etc" "$ROOT/work-etc" "$ROOT/upper-home" "$ROOT/work-home"
fi

# THE SANDBOX'S OWN SYSTEM TREE, INT-257. A btrfs reflink copy of /usr and the pacman database,
# owned by christian and so ROOT inside. Without it, host root owns /usr, host root maps to
# nobody inside, and root inside cannot install anything. Law 4 is not weakened to fix that --
# the sandbox gets a lower layer it owns instead. Absent copy: /usr stays the host's, and the
# banner says so rather than implying otherwise.
# THE LAYER TABLE decides every overlay, for the Law 0 probe and the session alike. A new
# session writes its table once; a resumed one reads the table it was born with.
# Building the layers can FAIL -- a snapshot that could not be taken, a copy that broke. A
# failure here is a refusal, never a session with a layer quietly missing (Law 0).
if [ "$CREATED" = "1" ]; then
    if ! layers_new "$ROOT"; then
        echo "  devshell REFUSES -- the session's layers could not be built" >&2
        rm -rf "$ROOT"
        exit 1
    fi
fi
OVERLAYS=()
USR_MODE="host"
HOME_MODE="full"
while IFS=$'\t' read -r name mnt lower; do
    mkdir -p "$ROOT/upper-$name" "$ROOT/work-$name"
    OVERLAYS+=(--overlay-src "$lower" --overlay "$ROOT/upper-$name" "$ROOT/work-$name" "$mnt")
    [ "$name" = "usr" ] && USR_MODE="copy"
    [ "$name" = "home" ] && [ "$lower" != "$HOME" ] && HOME_MODE="declared"
done < <(layers_read "$ROOT")

# THE SESSION'S OWN pacman.conf, INT-257 item 3. Host pacman drops privileges to DownloadUser
# (alpm) and chowns its download dir to it -- but only root is mapped inside, so that chown can
# never succeed. Each NEW session gets /etc/pacman.conf without the line, seeded into upper-etc
# before launch: inside it replaces the real one, and the host file is only ever read. A resumed
# session keeps whatever it already has.
if [ "$USR_MODE" = "copy" ] && [ "$CREATED" = "1" ]; then
    grep -v '^[[:space:]]*DownloadUser' /etc/pacman.conf > "$ROOT/upper-etc/pacman.conf"
fi

# .gitconfig is SEEDED, not overlaid: a single file cannot be an overlay, and identity for
# commits inside is the one thing the session needs from it. Its credential.helper points at a
# store that does not exist inside -- and the network is off regardless.
if [ "$HOME_MODE" = "declared" ] && [ "$CREATED" = "1" ] && [ -f "$HOME/.gitconfig" ]; then
    cp "$HOME/.gitconfig" "$ROOT/upper-home/.gitconfig"
fi

# THE BASE, INT-257 step 1 -- NOTHING PASSES THROUGH UNLESS A LAW NAMES IT.
# --dev-bind / / handed the sandbox every path no overlay covered: the Hyprland control socket,
# the session and system buses, the gpg and ssh agents, /dev/input, the camera, and a /tmp that
# was the host's. Now the host is READ-ONLY inside, /dev is bwrap's minimal set, and /tmp,
# /var/tmp and /run are private and empty. Read-only alone would not do it: a read-only mount
# refuses writes, not connect() on a socket -- the tmpfs mounts are what remove the sockets.
# nsh asks for a runtime dir, so it gets its own, empty one. The verify probe and the session
# use this SAME array, so Law 0 checks the world it hands over, not a neighbouring one.
RUNDIR="/run/user/$(id -u)"
BASE=(
    --ro-bind / /
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    --perms 0700 --dir "$RUNDIR"
)

if [ "$#" -eq 0 ]; then
    set -- /bin/bash --norc --noprofile -i
fi

# LAW 0 -- A SANDBOX THAT CANNOT DELIVER A LAW REFUSES.
#
# The banner used to PRINT the laws. Printing is what --isolate full did about pid isolation
# while 415 host processes were visible inside it. So the laws are TESTED here, in the world
# they govern, before anything is handed over.
# ⭐ THOROUGH AND FAST TURNED OUT NOT TO BE A TRADE-OFF. Measured 2026-09-20: the whole
# launch is 21ms, and a network probe costs 13ms because with no route at all curl fails
# INSTANTLY rather than waiting out its timeout. So every law is checked on every launch.
VERIFY='printf "%s %s %s %s %s %s" "$(id -u)" "$(hostname)" "$(ls /proc | grep -c \"^[0-9]\")" "$(ls /etc | wc -l)" "$(curl -s -m1 https://1.1.1.1 >/dev/null 2>&1 && echo REACH || echo BLOCKED)" "$(sudo -n true >/dev/null 2>&1 && echo SUDO || echo NOSUDO)"'
# LAW 0 GROWS TEETH FOR THE CENSUS, INT-257. The six checks above passed on EVERY launch while
# the session bus answered and /tmp was the host's -- they probed what was built, not what was
# passed through. Three more, each written for a CLASS rather than an example:
#   capabilities  CapEff must be zero. With any capability, root inside could unmount the
#                 private /run and expose the host's, where read-only still lets connect() in.
#   sockets       NO socket anywhere under /run, /tmp or /var/tmp. The buses, Hyprland, the
#                 agents, pipewire, X11 -- one count covers all of them, and whatever comes next.
#   tmp           a probe written to /tmp inside must NOT exist on the host afterwards --
#                 checked from the HOST, never by the sandbox reporting on itself.
L0PROBE="/tmp/.devshell-law0-$SESSION"
VERIFY="$VERIFY"'; printf " %s %s" "$(sed -n "s/^CapEff:[[:space:]]*//p" /proc/self/status)" "$(find /run /tmp /var/tmp -type s 2>/dev/null | wc -l)"'"; touch $L0PROBE"
# And what HOME holds inside -- the last field, so the listing can carry any number of names.
VERIFY="$VERIFY"'; printf " %s" "$(ls -A '"$HOME"' | tr "\n" " ")"'
read -r V_UID V_HOST V_PROCS V_ETC V_NET V_SUDO V_CAP V_SOCK V_HOME <<< "$(bwrap \
  --unshare-all --uid 0 --gid 0 --hostname devshell \
  "${BASE[@]}" \
  "${OVERLAYS[@]}" \
  --clearenv --setenv PATH "/usr/local/bin:/usr/bin:/bin" \
  -- /bin/sh -c "$VERIFY" 2>/dev/null)" || true

FAILED=""
[ "$V_UID" = "0" ]          || FAILED="$FAILED identity(uid=$V_UID)"
[ "$V_HOST" = "devshell" ]  || FAILED="$FAILED machine(host=$V_HOST)"
[ "${V_PROCS:-999}" -lt 20 ] 2>/dev/null || FAILED="$FAILED process(procs=$V_PROCS)"
[ "${V_ETC:-0}" -gt 50 ] 2>/dev/null    || FAILED="$FAILED filesystem(etc=$V_ETC)"
[ "$V_NET" = "BLOCKED" ]    || FAILED="$FAILED network($V_NET)"
[ "$V_SUDO" = "NOSUDO" ]    || FAILED="$FAILED sudo($V_SUDO)"
[ "$V_CAP" = "0000000000000000" ] || FAILED="$FAILED capabilities(eff=${V_CAP:-none})"
[ "${V_SOCK:-x}" = "0" ]    || FAILED="$FAILED sockets(n=${V_SOCK:-none})"
if [ -e "$L0PROBE" ]; then
    rm -f "$L0PROBE"
    FAILED="$FAILED tmp(reached-host)"
fi
# LAW 0, THE DECLARED HOME: nothing from the host's HOME that the table never declared may be
# visible inside. The session's own writes (its upper) are its own; anything else named here
# LEAKED. A session born before the declared HOME is refused on resume, not grandfathered --
# it was born able to read credentials.
ALLOWED=" .gitconfig "
while IFS=$'\t' read -r name mnt _; do
    case "$mnt" in
        "$HOME"/*) top="${mnt#"$HOME"/}"; ALLOWED="$ALLOWED${top%%/*} " ;;
    esac
done < <(layers_read "$ROOT")
LEAKED=""
for n in ${V_HOME:-}; do
    case "$ALLOWED" in *" $n "*) continue ;; esac
    [ -e "$ROOT/upper-home/$n" ] && continue
    LEAKED="$LEAKED,$n"
done
[ -z "$LEAKED" ] || FAILED="$FAILED home(undeclared=${LEAKED#,})"

if [ -n "$FAILED" ]; then
    echo "" >&2
    echo "  devshell REFUSES -- these laws were not delivered:$FAILED" >&2
    echo "  A sandbox that cannot deliver what it promised refuses rather than" >&2
    echo "  running the command anyway and reporting success." >&2
    # ⚠️ ONLY A SESSION THIS RUN CREATED IS REMOVED. A refusal on --resume must never delete
    # the world someone is returning to -- that would turn a safety check into data loss.
    [ "$CREATED" = "1" ] && rm -rf "$ROOT"
    exit 1
fi

echo "  devshell $SESSION"
echo "  upper: $ROOT"
echo "  laws:  fs=overlay pid=isolated net=none uid=0 host=devshell env=declared usr=$USR_MODE base=ro home=$HOME_MODE"
echo ""

exec bwrap \
  --unshare-all \
  --uid 0 --gid 0 \
  --hostname devshell \
  "${BASE[@]}" \
  "${OVERLAYS[@]}" \
  --clearenv \
  --setenv PATH "$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" \
  --setenv HOME "$HOME" \
  --setenv TERM "${TERM:-xterm-256color}" \
  --setenv XDG_RUNTIME_DIR "$RUNDIR" \
  --setenv DEVSHELL "$SESSION" \
  --setenv DEVSHELL_UPPER "$ROOT" \
  --setenv PS1 "devshell> " \
  -- "$@"
