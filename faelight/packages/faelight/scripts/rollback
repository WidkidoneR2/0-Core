#!/usr/bin/env bash
# Faelight Forest rollback -- NixOS-aware

echo "🌲 Faelight Rollback -- NixOS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "→ Rolling back to previous generation..."
sudo nixos-rebuild switch --flake ~/0-core#framework16 --rollback
echo ""
echo "✅ Rollback complete -- run: d to check health"
