#!/usr/bin/env bash
# faelight vm -- smooth VM workflow (INT-077)
# Subcommands: build | up | ssh | down | status
# Console path = SSH (host 2222 -> guest 22), per INT-077 gate 2.
set -euo pipefail

REPO="${FAELIGHT_REPO:-$HOME/0-core}"
FLAKE="$REPO#faelight-vm"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/faelight-vm"
PORT=2222
GUEST_USER=christian
LOG="$STATE/vm.log"
PIDFILE="$STATE/vm.pid"
SPICE_SOCK="$STATE/spice.sock"
LOCKFILE="$STATE/vm.lock"
SSH_OPTS=(-t -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p "$PORT")

mkdir -p "$STATE"

c_g=$'\e[38;2;57;255;20m'; c_c=$'\e[38;2;50;220;255m'
c_a=$'\e[38;2;255;200;50m'; c_r=$'\e[38;2;255;80;80m'; c_o=$'\e[0m'
info(){ printf '%s%s%s\n' "$c_c" "$*" "$c_o"; }
ok(){   printf '%s%s%s\n' "$c_g" "$*" "$c_o"; }
warn(){ printf '%s%s%s\n' "$c_a" "$*" "$c_o"; }
err(){  printf '%s%s%s\n' "$c_r" "$*" "$c_o" >&2; }

launcher(){ ls "$STATE"/result/bin/run-*-vm 2>/dev/null | head -1 || true; }
port_open(){ timeout 1 bash -c ">/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; }

# INT-077: fsh shadows pkill/kill/pgrep, so we identify+kill qemu via a Python /proc
# walker (proven reliable). vm_pids prints matching PIDs; vm_kill SIGKILLs them.
VMMATCH='qemu-system-x86_64'
vm_pids(){
  python3 - "$VMMATCH" <<'PYV'
import glob, sys
needle = sys.argv[1]
for d in glob.glob("/proc/[0-9]*"):
    try:
        cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
    except Exception:
        continue
    if needle in cmd and "faelight-vm" in cmd:
        print(d.split("/")[-1])
PYV
}
vm_kill(){
  python3 - "$VMMATCH" <<'PYV'
import glob, os, signal, sys, time
needle = sys.argv[1]
def find():
    out=[]
    for d in glob.glob("/proc/[0-9]*"):
        try:
            cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
        except Exception:
            continue
        if needle in cmd and "faelight-vm" in cmd:
            out.append(int(d.split("/")[-1]))
    return out
killed=[]
for pid in find():
    try: os.kill(pid, signal.SIGKILL); killed.append(pid)
    except ProcessLookupError: pass
time.sleep(1)
print("KILLED" if killed else "NONE", *killed)
print("REMAIN", *find())
PYV
}
kill_viewer(){
  python3 - <<'PYV'
import glob, os, signal
for d in glob.glob("/proc/[0-9]*"):
    try:
        cmd = open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
    except Exception:
        continue
    if "remote-viewer" in cmd and "spice" in cmd:
        try: os.kill(int(d.split("/")[-1]), signal.SIGKILL)
        except ProcessLookupError: pass
PYV
}

# INT-079 G1: atomic launch lock. Grabs an exclusive non-blocking flock on FD 9.
# A second concurrent up/gui cannot get the lock -> refuses instantly (no TOCTOU race).
# qemu's own qcow2 OFD lock remains the backstop underneath this.
vm_lock(){
  exec 9>"$LOCKFILE"
  if ! flock -n 9; then
    err "Another vm launch is in progress (lock: $LOCKFILE). Refusing to double-launch."
    exit 1
  fi
}

# INT-079 G2: stale-state janitor. Removes orphaned host-side state (spice.sock,
# vm.pid) left when the GUEST powers itself off (qemu exits, host `vm down` never ran).
# SAFETY: only acts when NO qemu is live -- never deletes state out from under a
# running VM. Uses the same /proc walker (vm_pids) the rest of the script trusts.
vm_clean_stale(){
  if [ -n "$(vm_pids)" ]; then return 0; fi   # a VM is alive -- touch nothing
  rm -f "$SPICE_SOCK" "$PIDFILE"
}

cmd_build(){
  # INT-024: optional mode arg selects the login flavour.
  #   vm build          -> faelight-vm          (mirror: tuigreet -> mango)
  #   vm build regreet  -> faelight-vm-regreet  (candy-neon ReGreet testbed)
  local mode="${1:-mirror}"
  local target
  case "$mode" in
    mirror)  target="$REPO#faelight-vm";;
    regreet) target="$REPO#faelight-vm-regreet";;
    *) err "vm build: unknown mode '$mode' (use: mirror | regreet)"; exit 2;;
  esac
  info "Building VM image [$mode] (nixos-rebuild build-vm; dirty tree uses tracked files)..."
  ( cd "$STATE" && nixos-rebuild build-vm --flake "$target" )
  local L; L="$(launcher)"
  [ -n "$L" ] && ok "VM image built [$mode] (GC-rooted): $L" || { err "build done but no run-*-vm launcher in $STATE/result/bin"; exit 1; }
}

cmd_up(){
  vm_lock
  vm_clean_stale
  local L; L="$(launcher)"
  [ -n "$L" ] || { err "No VM image. Run: vm build"; exit 1; }
  if [ -n "$(vm_pids)" ]; then err "A faelight-vm is ALREADY running (PIDs: $(vm_pids | tr '\n' ' ')). Run: vm down  first."; exit 1; fi
  if port_open; then ok "VM already up (port $PORT listening)"; return 0; fi
  info "Launching VM (headless, detached; log -> $LOG)..."
  ( cd "$STATE" && exec setsid "$L" >"$LOG" 2>&1 </dev/null ) &
  echo $! >"$PIDFILE"
  # INT-027 (2026-07-15): the old loop trusted port_open -- a LIE, measured at 9 seconds.
  # qemu binds the host forward port the instant it starts, so the loop matched on its FIRST
  # iteration and claimed "ssh ready after 2s" while the guest was still in OVMF; the guest's
  # sshd did not actually answer until 11s. It proved qemu launched, not that the guest was up.
  # Rust `faelight-vm wait-ready` reads the SSH BANNER instead: only a live guest sshd sends
  # "SSH-2.0-...". qemu with no guest listener accepts the connection and closes it -- 0 bytes.
  # Truth over speed.
  fvm wait-ready --port "$PORT" --timeout 120
}

cmd_ssh(){
  if ! port_open; then warn "VM not up; starting it..."; cmd_up; fi
  info "ssh -> $GUEST_USER@localhost:$PORT (password: faelight)"
  ssh "${SSH_OPTS[@]}" "$GUEST_USER@localhost" "$@"
}

cmd_down(){
  # INT-077: kill qemu by real PID via Python (/proc), NOT fsh's broken pkill.
  local res; res="$(vm_kill)"
  # REMAIN line lists leftover PIDs after the label; strip label, keep only real PIDs.
  local remain; remain="$(echo "$res" | sed -n 's/^REMAIN //p' | tr -s ' ')"
  remain="$(echo "$remain" | grep -o '[0-9][0-9]*' | tr '\n' ' ' || true)"
  local killpids; killpids="$(echo "$res" | sed -n 's/^KILLED //p')"
  if [ -n "$killpids" ]; then ok "VM stopped ($killpids)."; else warn "No running VM found."; fi
  if [ -n "$remain" ]; then err "WARNING: qemu still running: $remain (manual: /run/current-system/sw/bin/kill -9 $remain)"; fi
  kill_viewer
  rm -f "$PIDFILE" "$SPICE_SOCK"
  info "Disk state persists at $STATE/*.qcow2 (delete for a clean boot; deeper reset -> INT-027)."
}

cmd_gui(){
  vm_lock
  vm_clean_stale
  local L; L="$(launcher)"
  [ -n "$L" ] || { err "No VM image. Run: vm build"; exit 1; }
  if [ -n "$(vm_pids)" ] || port_open; then
    warn "A VM is already running. Run: vm down  then  vm gui"
    exit 1
  fi
  command -v remote-viewer >/dev/null || { err "remote-viewer not found (pkgs.virt-viewer on host)"; exit 1; }
  kill_viewer
  rm -f "$SPICE_SOCK"
  info "Launching VM with SPICE display (socket: $SPICE_SOCK)..."
  # SPICE on a unix socket + qxl display + agent channel for shared clipboard.
  # INT-080: -vga qxl = ONE clean SPICE display surface for the everyday
  # watching loop. The previous GL display combo emitted a SECOND surface
  # (a window stuck at boot) -- that GL scaffolding was INT-077 Gate-6
  # Pinnacle render work, which belongs to real hardware (INT-067), not here.
  local QOPTS="-vga qxl -spice unix=on,addr=$SPICE_SOCK,disable-ticketing=on -device virtio-serial-pci -chardev spicevmc,id=vdagent,name=vdagent -device virtserialport,chardev=vdagent,name=com.redhat.spice.0"
  ( cd "$STATE" && exec setsid env QEMU_OPTS="$QOPTS" "$L" >"$LOG" 2>&1 </dev/null ) &
  echo $! >"$PIDFILE"
  local i
  for i in $(seq 1 30); do [ -S "$SPICE_SOCK" ] && break; sleep 1; done
  [ -S "$SPICE_SOCK" ] || { err "SPICE socket never appeared -- check $LOG"; exit 1; }
  ok "SPICE up. Opening remote-viewer (windowed)..."
  setsid remote-viewer "spice+unix://$SPICE_SOCK" >>"$LOG" 2>&1 </dev/null &  # INT-077: windowed (NOT fullscreen) -- closeable, no screen-trap
  ok "Viewer launched. SSH still available: vm ssh"
}

cmd_debug(){
  # INT-079 G3: read-only diagnostic. Launches nothing, kills nothing, signals nothing.
  info "faelight-vm debug (read-only)"
  STATE="$STATE" PORT="$PORT" LOCKFILE="$LOCKFILE" SPICE_SOCK="$SPICE_SOCK" \
  PIDFILE="$PIDFILE" python3 - <<'PYD'
import os, glob, socket
STATE=os.environ["STATE"]; PORT=int(os.environ["PORT"])
LOCK=os.environ["LOCKFILE"]; SOCK=os.environ["SPICE_SOCK"]; PIDF=os.environ["PIDFILE"]

# live qemu (via /proc, same approach as vm_pids)
live=[]
for d in glob.glob("/proc/[0-9]*"):
    try: cmd=open(d+"/cmdline","rb").read().replace(b"\x00",b" ").decode("utf-8","replace")
    except Exception: continue
    if "qemu-system-x86_64" in cmd and "faelight-vm" in cmd:
        live.append((d.split("/")[-1], cmd))
print(f"  qemu (faelight-vm) alive : {len(live)}")
for pid,cmd in live:
    print(f"    PID {pid}  guard-match={'YES' if 'faelight-vm' in cmd else 'NO'}")

# port 2222
s=socket.socket(); s.settimeout(0.4)
try: s.connect(("127.0.0.1",PORT)); print(f"  port {PORT}              : LISTENING")
except Exception: print(f"  port {PORT}              : closed")
finally: s.close()

# lock state: non-blocking flock on FD 8; if we GET it, nothing held it -> release at once.
import fcntl
held=None
try:
    fd=os.open(LOCK, os.O_CREAT|os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
        held=False                      # we acquired -> was free
        fcntl.flock(fd, fcntl.LOCK_UN)  # release immediately
    except BlockingIOError:
        held=True                       # someone else holds it -> a launch is in progress
    finally:
        os.close(fd)
except Exception as e:
    held=None; print(f"  lock                   : (probe error: {e})")
if held is not None:
    print(f"  launch lock            : {'HELD (launch in progress)' if held else 'free'}")

# stale-state view (what the janitor would act on)
sock_exists=os.path.exists(SOCK)
pid_txt=open(PIDF).read().strip() if os.path.isfile(PIDF) else None
pid_alive=os.path.isdir(f"/proc/{pid_txt}") if (pid_txt and pid_txt.isdigit()) else False
print(f"  spice.sock present     : {sock_exists}")
print(f"  vm.pid                 : {pid_txt if pid_txt else 'none'}"
      f"{' (stale: setsid pid, not qemu)' if pid_txt else ''}")
if not live and (sock_exists or pid_txt):
    print("  --> janitor would CLEAN these (no live qemu)")
elif live and (sock_exists or pid_txt):
    print("  --> janitor leaves them (VM is live)")

# disk
for q in sorted(glob.glob(os.path.join(STATE,"*.qcow2"))):
    try: sz=os.path.getsize(q)/1024**2
    except OSError: sz=-1
    print(f"  disk                   : {q} ({sz:.0f}M)")
print("  (read-only -- nothing launched, killed, or written)")
PYD
}

cmd_status(){
  vm_clean_stale
  local L; L="$(launcher)"
  printf '%sfaelight-vm%s\n' "$c_c" "$c_o"
  [ -n "$L" ] && ok "  image:  $L" || warn "  image:  none (run: vm build)"
  if port_open; then ok "  state:  UP (port $PORT listening)"; else warn "  state:  down"; fi
  [ -f "$LOG" ] && info "  log:    $LOG" || true
  for q in "$STATE"/*.qcow2; do [ -e "$q" ] && info "  disk:   $q ($(du -h "$q" | cut -f1))"; done
}

usage(){
  cat <<EOF
faelight vm -- smooth VM workflow (INT-077)
  vm build    build/refresh the VM image (slow; run when hosts/vm/ changes)
  vm up       launch headless + wait for ssh (port $PORT)
  vm ssh [c]  ssh into the guest (optional remote command)
  vm down     stop the VM (disk state persists)
  vm status   image / running / disk
  vm debug    read-only diagnostic (live state, guard, lock, stale-state)
  vm gui      launch with a SPICE window (remote-viewer) + shared clipboard

Snapshots (INT-027 -- Rust faelight-vm; VM must be DOWN):
  vm snapshot <tag>   snapshot disk + OVMF EFI vars (both or neither)
  vm rollback <tag>   restore a snapshot (auto-snapshots current state first)
  vm snapshots        list snapshots
  vm delete <tag>     delete a snapshot
  vm prune [--all]    remove auto-* snapshots (>14d default; --dry-run to look)
Console = SSH (host $PORT -> guest 22). Guest: $GUEST_USER / pw faelight.
EOF
}

# INT-027: snapshot/rollback live in the Rust `faelight-vm` tool, not here.
# The START of the organic bash->Rust migration: NEW capability built in Rust; this
# script stays the single front door (INT-079 G3) and forwards these verbs to it.
# Rust owns the state logic (disk qcow2 + OVMF EFI vars must move together).
fvm(){
  command -v faelight-vm >/dev/null 2>&1 || {
    err "faelight-vm not on PATH -- run: dep  (it ships with faelight-forest)"; exit 1; }
  faelight-vm "$@"
}

case "${1:-}" in
  build)  shift; cmd_build  "$@";;
  up)     shift; cmd_up     "$@";;
  ssh)    shift; cmd_ssh    "$@";;
  down)   shift; cmd_down   "$@";;
  gui)    shift; cmd_gui    "$@";;
  status) shift; cmd_status "$@";;
  debug)  shift; cmd_debug  "$@";;
  # --- INT-027: forwarded to the Rust faelight-vm ---
  snapshot|snap)   shift; fvm snapshot  "$@";;
  rollback)        shift; fvm rollback  "$@";;
  snapshots|snaps) shift; fvm snapshots "$@";;
  delete)          shift; fvm delete    "$@";;
  prune)           shift; fvm prune     "$@";;
  ""|-h|--help|help) usage;;
  *) err "unknown subcommand: $1"; usage; exit 2;;
esac
